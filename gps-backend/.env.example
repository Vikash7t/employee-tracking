# Database Configuration (MySQL - legacy)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=employee_tracking

# Security Containment Keys (Legacy API)
ADMIN_SECRET_KEY=replace_with_secure_admin_key_for_reading_locations
CLIENT_API_KEY=replace_with_secure_client_key_for_ingestion

# Set to 'true' only after updated mobile APK with x-api-key is distributed
ENFORCE_CLIENT_API_KEY=false

# Allowed CORS Origins (comma-separated, or * for dev)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
