datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum MembershipRole {
  OWNER
  ORG_ADMIN
  MANAGER
  MEMBER
}

enum WorksiteType {
  CIRCULAR
  POLYGON
}

model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  email               String                   @unique @db.VarChar(150)
  fullName            String                   @map("full_name") @db.VarChar(150)
  passwordHash        String?                  @map("password_hash") @db.VarChar(255)
  pinHash             String?                  @map("pin_hash") @db.VarChar(255)
  isActive            Boolean                  @default(true) @map("is_active")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions            Session[]
  memberships         OrganizationMembership[]
  employeeProfiles    EmployeeProfile[]
  createdInvitations  EmployeeInvitation[]     @relation("CreatedInvitations")

  @@map("users")
}

model Session {
  id                   String       @id @default(uuid()) @db.Uuid
  userId               String       @map("user_id") @db.Uuid
  activeOrganizationId String       @map("active_organization_id") @db.Uuid
  tokenHash            String       @unique @map("token_hash") @db.VarChar(64)
  ipAddress            String?      @map("ip_address") @db.VarChar(45)
  userAgent            String?      @map("user_agent") @db.VarChar(255)
  expiresAt            DateTime     @map("expires_at") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization         Organization @relation(fields: [activeOrganizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("sessions")
}

model Organization {
  id                   String                   @id @default(uuid()) @db.Uuid
  name                 String                   @db.VarChar(150)
  slug                 String                   @unique @db.VarChar(50)
  timezone             String                   @default("Asia/Kolkata") @db.VarChar(50)
  isActive             Boolean                  @default(true) @map("is_active")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  worksites            Worksite[]
  memberships          OrganizationMembership[]
  employeeProfiles     EmployeeProfile[]
  sessions             Session[]
  invitations          EmployeeInvitation[]
  attendanceEvents     AttendanceEvent[]
  attendanceSessions   AttendanceSession[]

  @@map("organizations")
}

model OrganizationMembership {
  id                   String                   @id @default(uuid()) @db.Uuid
  organizationId       String                   @map("organization_id") @db.Uuid
  userId               String                   @map("user_id") @db.Uuid
  role                 MembershipRole           @default(MEMBER)
  isActive             Boolean                  @default(true) @map("is_active")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  worksiteScopes       ManagerWorksiteScope[]
  departmentScopes     ManagerDepartmentScope[]
  employeeProfile      EmployeeProfile?

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_memberships")
}

model ManagerWorksiteScope {
  id           String                 @id @default(uuid()) @db.Uuid
  membershipId String                 @map("membership_id") @db.Uuid
  worksiteId   String                 @map("worksite_id") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  worksite     Worksite               @relation(fields: [worksiteId], references: [id], onDelete: Cascade)

  @@unique([membershipId, worksiteId])
  @@map("manager_worksite_scopes")
}

model ManagerDepartmentScope {
  id           String                 @id @default(uuid()) @db.Uuid
  membershipId String                 @map("membership_id") @db.Uuid
  department   String                 @db.VarChar(100)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, department])
  @@map("manager_department_scopes")
}

model Worksite {
  id                   String                 @id @default(uuid()) @db.Uuid
  organizationId       String                 @map("organization_id") @db.Uuid
  name                 String                 @db.VarChar(150)
  worksiteType         WorksiteType           @default(CIRCULAR) @map("worksite_type")
  latitude             Decimal                @db.Decimal(10, 8)
  longitude            Decimal                @db.Decimal(11, 8)
  radiusMeters         Int                    @default(50) @map("radius_meters")
  polygonCoordinates   Json?                  @map("polygon_coordinates")
  gracePeriodSeconds   Int                    @default(120) @map("grace_period_seconds")
  isActive             Boolean                @default(true) @map("is_active")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerScopes        ManagerWorksiteScope[]
  primaryEmployees     EmployeeProfile[]
  attendanceSessions   AttendanceSession[]

  @@index([organizationId])
  @@map("worksites")
}

model EmployeeProfile {
  id                   String                  @id @default(uuid()) @db.Uuid
  organizationId       String                  @map("organization_id") @db.Uuid
  userId               String?                 @map("user_id") @db.Uuid
  membershipId         String?                 @unique @map("membership_id") @db.Uuid
  employeeCode         String                  @map("employee_code") @db.VarChar(50)
  fullName             String                  @map("full_name") @db.VarChar(150)
  department           String?                 @db.VarChar(100)
  primaryWorksiteId    String?                 @map("primary_worksite_id") @db.Uuid
  failedAttempts       Int                     @default(0) @map("failed_attempts")
  lockoutUntil         DateTime?               @map("lockout_until") @db.Timestamptz(6)
  isActive             Boolean                 @default(true) @map("is_active")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  membership           OrganizationMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  primaryWorksite      Worksite?               @relation(fields: [primaryWorksiteId], references: [id], onDelete: SetNull)
  devices              DeviceBinding[]
  invitations          EmployeeInvitation[]
  attendanceEvents     AttendanceEvent[]
  attendanceSessions   AttendanceSession[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId])
  @@index([userId])
  @@map("employee_profiles")
}

model DeviceBinding {
  id                 String          @id @default(uuid()) @db.Uuid
  employeeProfileId  String          @map("employee_profile_id") @db.Uuid
  deviceId           String          @map("device_id") @db.VarChar(128)
  deviceSecretHash   String          @map("device_secret_hash") @db.VarChar(64)
  deviceModel        String?         @map("device_model") @db.VarChar(100)
  osVersion          String?         @map("os_version") @db.VarChar(50)
  isTrusted          Boolean         @default(true) @map("is_trusted")
  registeredAt       DateTime        @default(now()) @map("registered_at") @db.Timestamptz(6)
  lastSeenAt         DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  employeeProfile    EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, deviceId])
  @@index([employeeProfileId])
  @@map("device_bindings")
}

model EmployeeInvitation {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  employeeProfileId  String          @map("employee_profile_id") @db.Uuid
  email              String          @db.VarChar(150)
  tokenHash          String          @unique @map("token_hash") @db.VarChar(64)
  expiresAt          DateTime        @map("expires_at") @db.Timestamptz(6)
  usedAt             DateTime?       @map("used_at") @db.Timestamptz(6)
  createdByUserId    String          @map("created_by_user_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeProfile    EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  createdByUser      User            @relation("CreatedInvitations", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("employee_invitations")
}

model AttendanceEvent {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  employeeProfileId  String          @map("employee_profile_id") @db.Uuid
  eventType          String          @map("event_type") @db.VarChar(50)
  sequenceNumber     Int             @map("sequence_number")
  clientTimestamp    DateTime        @map("client_timestamp") @db.Timestamptz(6)
  elapsedRealtimeMs  BigInt?         @map("elapsed_realtime_ms")
  serverReceivedAt   DateTime        @default(now()) @map("server_received_at") @db.Timestamptz(6)
  payload            Json
  signature          String?         @db.VarChar(64)
  isReconciled       Boolean         @default(false) @map("is_reconciled")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeProfile    EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, employeeProfileId, sequenceNumber])
  @@index([organizationId, clientTimestamp])
  @@map("attendance_events")
}

model AttendanceSession {
  id                      String               @id @default(uuid()) @db.Uuid
  organizationId          String               @map("organization_id") @db.Uuid
  employeeProfileId       String               @map("employee_profile_id") @db.Uuid
  worksiteId              String               @map("worksite_id") @db.Uuid
  status                  String               @default("ACTIVE") @db.VarChar(30)
  presenceStatus          String               @default("INSIDE") @map("presence_status") @db.VarChar(30)
  reviewStatus            String               @default("NOT_REQUIRED") @map("review_status") @db.VarChar(30)
  clockInAt               DateTime             @map("clock_in_at") @db.Timestamptz(6)
  clockOutAt              DateTime?            @map("clock_out_at") @db.Timestamptz(6)
  exitPendingSince        DateTime?            @map("exit_pending_since") @db.Timestamptz(6)
  exitGraceExpiresAt      DateTime?            @map("exit_grace_expires_at") @db.Timestamptz(6)
  insideDurationSeconds   Int                  @default(0) @map("inside_duration_seconds")
  outsideDurationSeconds  Int                  @default(0) @map("outside_duration_seconds")
  breakDurationSeconds    Int                  @default(0) @map("break_duration_seconds")
  autoClockedOut          Boolean              @default(false) @map("auto_clocked_out")
  lastEvaluatedAt         DateTime             @default(now()) @map("last_evaluated_at") @db.Timestamptz(6)
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeProfile         EmployeeProfile      @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  worksite                Worksite             @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  intervals               AttendanceInterval[]

  @@index([organizationId])
  @@index([employeeProfileId])
  @@index([worksiteId])
  @@index([status])
  @@index([organizationId, employeeProfileId, status])
  @@map("attendance_sessions")
}

model AttendanceInterval {
  id                   String             @id @default(uuid()) @db.Uuid
  attendanceSessionId  String             @map("attendance_session_id") @db.Uuid
  intervalType         String             @map("interval_type") @db.VarChar(30)
  startedAt            DateTime           @map("started_at") @db.Timestamptz(6)
  endedAt              DateTime?          @map("ended_at") @db.Timestamptz(6)
  durationSeconds      Int?               @map("duration_seconds")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  attendanceSession    AttendanceSession  @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  @@index([attendanceSessionId])
  @@map("attendance_intervals")
}

