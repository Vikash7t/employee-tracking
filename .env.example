# ==============================================================================
# Enterprise Workforce Attendance & Geospatial Tracking System
# Environment Configuration Template
# Copy this file to '.env' and populate with deployment-specific credentials.
# NEVER commit production '.env' files or credentials to source control.
# ==============================================================================

# Node Environment ('development' | 'test' | 'staging' | 'production')
NODE_ENV=development

# Backend HTTP Listening Port
PORT=4000

# PostgreSQL + PostGIS Database Connection URL
# Production Note: Must use TLS ('sslmode=require') and non-default credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/employee_tracking_dev?schema=public"

# Cryptographic JWT Signing Secret (Minimum 32 characters in production)
JWT_SECRET="dev_jwt_secret_key_change_in_production_min_32_chars"

# Allowed CORS Origins (Comma-separated URLs)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Admin Dashboard Frontend Configuration
ADMIN_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:4000"
